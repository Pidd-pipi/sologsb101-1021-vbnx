{
  "name": "gbsealcarve-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "篆刻印章与钤印记录台 - 纯前端 SPA（Svelte 5 + TypeScript + Vite + history 路由 + Tailwind CSS + Dexie）",
  "scripts": {
    "dev": "vite --host --port 22821",
    "build": "svelte-check --tsconfig ./tsconfig.json --threshold error && vite build",
    "preview": "vite preview --host --port 22821",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "svelte": "^5.20.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.20.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
